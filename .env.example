# Copie para .env.local e preencha.
# Local: rode `npx supabase start` e use as chaves que ele imprime (veja o README).
# Produção: Supabase > Project Settings > API Keys.
# Na Vercel com a integração Supabase, as variáveis dela (SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY) já servem: não precisa destas três.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: SÓ no servidor, nunca com NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# E-mails que viram admin ao entrar (separados por vírgula).
# Com "Confirm email" desligado no Supabase, prefira role = 'admin' em profiles (veja o README, Segurança).
ADMIN_EMAILS=

# Google Places API (New). Coloque limite diário de cota e alerta de orçamento de US$ 1 no Google Cloud.
GOOGLE_MAPS_API_KEY=
# Teto diário de chamadas ao Google pelas rotas públicas (fotos e horários). Padrão 500.
# GOOGLE_DAILY_LIMIT=500

# IA de visão para o script de ingestão (escolha um)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# WhatsApp do time Kombin (só dígitos, com 55 + DDD): contato de restaurantes e venda de destaque
KOMBIN_CONTACT_WHATSAPP=

# Minutos depois do clique em WhatsApp/Como chegar para perguntar "Como foi?" (padrão 90)
# REVIEW_DELAY_MINUTES=90
