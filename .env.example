# Copie para .env.local e preencha. Sem nada preenchido, o app roda em modo demonstração.

# Supabase (Project Settings > API). A service role fica SÓ no servidor, nunca no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API (New). Coloque limite diário de cota e alerta de orçamento de US$ 1 no Google Cloud.
GOOGLE_MAPS_API_KEY=

# IA de visão para o script de ingestão (escolha um)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Senha do /admin (obrigatória fora do modo demo)
ADMIN_PASSWORD=

# WhatsApp do time Kombin para "É dono deste lugar?" (só dígitos, com 55 + DDD)
KOMBIN_CONTACT_WHATSAPP=

# Minutos depois do clique em WhatsApp/Como chegar para perguntar "Como foi?" (padrão 90; demo 1)
# REVIEW_DELAY_MINUTES=90
